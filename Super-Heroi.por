programa {
  funcao inicio() {
        cadeia nome
        inteiro nivelPoder
        real velocidadeMaxima
        logico habilidadeVoo

        nome = "Supergirl"
        nivelPoder = 500
        velocidadeMaxima = 299792.0
        habilidadeVoo = verdadeiro

        escreva("===== FICHA DO SUPER-HERÓI =====\n")
        escreva("Nome: ", nome, "\n")
        escreva("Nível de poder: ", nivelPoder, "\n")
        escreva("Velocidade máxima: ", velocidadeMaxima, " km/h\n")
        escreva("Habilidade de voo: ", habilidadeVoo)

  }
}
