programa {
  funcao inicio() {
    cadeia nomeProduto = "Fone de ouvido"
    inteiro quantidade = 2
    real valorTotal = 140.90
    logico freteGratis = verdadeiro

    escreva("Produto:", nomeProduto, "\n")
    escreva("Quantidade:",quantidade, "\n")
    escreva("Valor total: R$", valorTotal, "\n")
    escreva("Frete grátis:", freteGratis)
  }
}
